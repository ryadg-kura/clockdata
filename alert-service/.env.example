# Adresse du broker Kafka
KAFKA_BOOTSTRAP=localhost:9092

# Compte Gmail expéditeur (utiliser un App Password Google, pas le vrai mot de passe)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.adresse@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Email du destinataire des alertes (proche ou urgentiste)
ALERT_RECIPIENT=destinataire@email.com
